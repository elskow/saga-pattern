FROM golang:1.25.0-alpine AS builder

WORKDIR /build

RUN apk add --no-cache git

COPY . .

ARG SERVICE_PATH

ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64

RUN go build -buildvcs=false -o /out/application ./${SERVICE_PATH}/cmd/server

FROM alpine:3.21

RUN apk add --no-cache curl ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

ENV TZ=UTC

WORKDIR /app

COPY --from=builder /out/application /app/application
COPY --from=builder /build/choreography-saga/order-service/db /app/choreography-saga/order-service/db
COPY --from=builder /build/choreography-saga/payment-service/db /app/choreography-saga/payment-service/db
COPY --from=builder /build/choreography-saga/inventory-service/db /app/choreography-saga/inventory-service/db
COPY --from=builder /build/choreography-saga/shipping-service/db /app/choreography-saga/shipping-service/db
COPY --from=builder /build/choreography-framework/db /app/choreography-framework/db
COPY --from=builder /build/orchestration-framework/db /app/orchestration-framework/db
COPY --from=builder /build/orchestration-saga/order-service/db /app/orchestration-saga/order-service/db
COPY --from=builder /build/orchestration-saga/payment-service/db /app/orchestration-saga/payment-service/db
COPY --from=builder /build/orchestration-saga/inventory-service/db /app/orchestration-saga/inventory-service/db
COPY --from=builder /build/orchestration-saga/shipping-service/db /app/orchestration-saga/shipping-service/db

RUN chown appuser:appgroup /app/application && chmod 755 /app/application

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -f http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

ENTRYPOINT ["/app/application"]
