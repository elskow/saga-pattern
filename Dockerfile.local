FROM maven:3.9-eclipse-temurin-25 AS builder

WORKDIR /build

COPY . .

ARG SERVICE_PATH

RUN mvn install -N -DskipTests -B && \
    mvn install -pl common -DskipTests -B && \
    mvn -pl ${SERVICE_PATH} -am package spring-boot:repackage -DskipTests -B

FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache curl tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

ENV TZ=UTC

WORKDIR /app

ARG SERVICE_PATH

COPY --from=builder /build/${SERVICE_PATH}/target/*.jar /app/application.jar

RUN chown appuser:appgroup /app/application.jar

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/application.jar"]
