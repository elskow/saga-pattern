# Simple JVM Dockerfile for local development - faster builds
# Usage: docker build --build-arg SERVICE_PATH=choreography-saga/order-service -t image-name .

FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /build

# Copy entire project (needed for multi-module build)
COPY . .

# Build arg for which service to build
ARG SERVICE_PATH

# Build the service JAR with Spring Boot repackaging
RUN mvn install -N -DskipTests -B && \
    mvn install -pl common -DskipTests -B && \
    mvn -pl ${SERVICE_PATH} -am package spring-boot:repackage -DskipTests -B

# Runtime stage
FROM eclipse-temurin:17-jre-alpine

# Install curl for healthchecks
RUN apk add --no-cache curl tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

ENV TZ=UTC

WORKDIR /app

ARG SERVICE_PATH

# Copy JAR from builder
COPY --from=builder /build/${SERVICE_PATH}/target/*.jar /app/application.jar

RUN chown appuser:appgroup /app/application.jar

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:${SERVER_PORT:-8080}/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/application.jar"]
