    {
      "id": 1,
      "title": "How To Use",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "# k6 Throughput Analysis\n\nUse this first for Bab 4 high-level evidence. It answers: how many saga journeys per second did k6 complete, how many HTTP requests did that require, did every journey reach the expected terminal status, and what latency did the client observe?"
      },
      "pluginVersion": "12.1.1"
    },
    {
      "id": 2,
      "title": "Peak Journey TPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.1.1",
      "targets": [
        {
          "expr": "sum(max_over_time(rate(k6_iterations_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[1m])[$__range:]))",
