  "panels": [
    {
      "id": 1,
      "title": "How To Use",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "# Secondary Suite Analysis\n\nUse this dashboard for the supplemental scalability and resilience suites. It intentionally prefers counter-derived business terminal ratio `(completed + cancelled) / started` over `max_over_time(k6_saga_terminal_success_rate)` so saturation phases cannot be hidden by a later clean sample."
      },
      "pluginVersion": "12.1.1"
    },
    {
      "id": 2,
      "title": "Business Terminal Ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "description": "Counter-derived ratio: completed plus cancelled orders divided by orders started. This exposes contention saturation better than max terminal-success samples.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.1.1",
      "targets": [
        {
          "expr": "(sum(max_over_time(k6_saga_orders_completed_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[$__range])) + sum(max_over_time(k6_saga_orders_cancelled_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[$__range]))) / clamp_min(sum(max_over_time(k6_saga_orders_started_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[$__range])), 1)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
