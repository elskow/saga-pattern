    {
      "id": 14,
      "title": "Business Step P95 vs Orchestration Framework P95 (ms)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "12.1.1",
      "description": "Capture this as grafana-step-latency.png to show the scale difference between business logic and orchestration coordination.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(saga_step_payment_duration_seconds_bucket{pattern=~\"$pattern\"}[$__range]))) * 1000",
          "legendFormat": "business / payment",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(saga_step_inventory_duration_seconds_bucket{pattern=~\"$pattern\"}[$__range]))) * 1000",
          "legendFormat": "business / inventory",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(saga_step_shipping_duration_seconds_bucket{pattern=~\"$pattern\"}[$__range]))) * 1000",
          "legendFormat": "business / shipping",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(saga_framework_step_duration_seconds_bucket[$__range]))) * 1000",
          "legendFormat": "orchestration / framework",
          "instant": true
        }
      ]
    },
    {
      "id": 19,
      "title": "Throughput Speedup by Scenario",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "12.1.1",
      "description": "Values above 1 mean choreography reached higher peak journey throughput than orchestration for the selected scenario window.",
      "targets": [
        {
          "expr": "sum by (scenario) (max_over_time(rate(k6_iterations_total{suite_label=~\"$suite_label\",pattern=\"choreography\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[1m])[$__range:])) / clamp_min(sum by (scenario) (max_over_time(rate(k6_iterations_total{suite_label=~\"$suite_label\",pattern=\"orchestration\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[1m])[$__range:])), 0.001)",
          "legendFormat": "{{scenario}}",
          "instant": true
        }
      ]
    },
    {
      "id": 20,
      "title": "P95 Latency Delta by Scenario (ms)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 47,
        "w": 8,
