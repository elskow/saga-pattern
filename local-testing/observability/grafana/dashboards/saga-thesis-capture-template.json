      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "12.1.1",
      "description": "Positive milliseconds mean orchestration p95 was slower than choreography in the selected scenario window.",
      "targets": [
        {
          "expr": "avg by (scenario) (max_over_time(k6_saga_duration_ms_p95{suite_label=~\"$suite_label\",pattern=\"orchestration\",scenario=~\"$scenario\",run_label=~\"$run_label\",final_status!=\"TIMED_OUT\"}[$__range])) - avg by (scenario) (max_over_time(k6_saga_duration_ms_p95{suite_label=~\"$suite_label\",pattern=\"choreography\",scenario=~\"$scenario\",run_label=~\"$run_label\",final_status!=\"TIMED_OUT\"}[$__range]))",
          "legendFormat": "{{scenario}}",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "title": "Contention: Started vs Terminal vs Failed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 47,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.1.1",
      "description": "Use for contention captures to show that high iteration/request volume is not equivalent to business-terminal success.",
      "targets": [
        {
          "expr": "sum by (pattern) (max_over_time(k6_saga_orders_started_total{suite_label=~\"$suite_label\",scenario=\"contention\",pattern=~\"$pattern\",run_label=~\"$run_label\"}[$__interval]))",
          "legendFormat": "started / {{pattern}}"
        },
        {
          "expr": "sum by (pattern) (max_over_time(k6_saga_orders_completed_total{suite_label=~\"$suite_label\",scenario=\"contention\",pattern=~\"$pattern\",run_label=~\"$run_label\"}[$__interval])) + sum by (pattern) (max_over_time(k6_saga_orders_cancelled_total{suite_label=~\"$suite_label\",scenario=\"contention\",pattern=~\"$pattern\",run_label=~\"$run_label\"}[$__interval]))",
          "legendFormat": "terminal / {{pattern}}"
        },
        {
          "expr": "sum by (pattern) (max_over_time(k6_saga_orders_failed_total{suite_label=~\"$suite_label\",scenario=\"contention\",pattern=~\"$pattern\",run_label=~\"$run_label\"}[$__interval]))",
          "legendFormat": "failed / {{pattern}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Compensation Lifecycle by Pattern",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
