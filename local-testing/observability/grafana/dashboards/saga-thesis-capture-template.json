          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.1.1",
      "description": "Use for failure captures to relate failed-order activity, application compensation, and orchestration-framework compensation lifecycle.",
      "targets": [
        {
          "expr": "sum by (pattern) (rate(saga_orders_failed_total{pattern=~\"$pattern\"}[1m]))",
          "legendFormat": "failed orders / {{pattern}}"
        },
        {
          "expr": "sum by (pattern) (rate(saga_compensations_total{pattern=~\"$pattern\"}[1m]))",
          "legendFormat": "app compensations / {{pattern}}"
        },
        {
          "expr": "sum(rate(saga_framework_compensation_started_total[1m]))",
          "legendFormat": "framework compensation started"
        },
        {
          "expr": "sum(rate(saga_framework_compensation_completed_total[1m]))",
          "legendFormat": "framework compensation completed"
        }
      ]
    },
