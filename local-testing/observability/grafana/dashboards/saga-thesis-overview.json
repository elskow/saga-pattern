    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Defense guide: use this dashboard while a Grafana-mode k6 run is active, or set time range to the run window. DB terminal-state artifacts remain the correctness source of truth; this dashboard explains performance and behavior.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "# Saga Thesis Defense View\n\nRead top-to-bottom: k6 user-facing result -> terminal correctness -> latency/throughput by scenario -> service/runtime root cause -> network/trace/profile evidence -> resource pressure. Use suite mode so every phase is in one continuous runtime and observability window, then slice by suite_label, pattern, scenario, and run_label. DB terminal-state artifacts remain the correctness authority; this dashboard is the fast visual analysis surface.",
        "mode": "markdown"
      },
      "pluginVersion": "12.1.1",
      "title": "How To Read This Dashboard",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.1.1",
      "targets": [
        {
          "expr": "sum by (suite_label, pattern, scenario, run_label) (max_over_time(k6_iterations_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[$__range]))",
          "legendFormat": "{{suite_label}} / {{pattern}} / {{scenario}}",
          "instant": true
        }
      ],
      "title": "k6 Completed Iterations",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
