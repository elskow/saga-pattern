      "targets": [
        {
          "expr": "sum by (suite_label, pattern, scenario, run_label) (max_over_time(k6_iterations_total{suite_label=~\"$suite_label\",pattern=~\"$pattern\",scenario=~\"$scenario\",run_label=~\"$run_label\"}[$__range]))",
